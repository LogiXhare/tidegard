# WetechiNetMon notifier (ADR 0052), installed by install.sh. Settings live in
# /etc/wetechinetmon/notifier.env, which only root reads.
[Unit]
Description=WetechiNetMon notifier
Documentation=https://github.com/LogiXhare/wetechi-netmon
After=network-online.target wetechinetmon-incident-manager.service
Wants=network-online.target

[Service]
Type=exec
User=wetechinetmon-notifier
Group=wetechinetmon-notifier
EnvironmentFile=/etc/wetechinetmon/notifier.env
ExecStart=/opt/wetechinetmon/bin/wetechinetmon-notifier
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Hardening: nothing here needs privilege, a writable system, devices or
# other users' files.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
