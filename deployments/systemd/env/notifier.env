# The notifier. Read by systemd as root, so keep this file 0600. Channel
# secrets live in files named by notifier.json, never here.
TIDEGARD_NOTIFY_CONFIG=/etc/tidegard/notifier.json
TIDEGARD_NOTIFY_DATABASE_URL="host=127.0.0.1 user=tidegard password=CHANGE_ME dbname=tidegard"
# TIDEGARD_NOTIFY_DATABASE_CA_FILE=/etc/tidegard/tls/ca.pem
TIDEGARD_NOTIFY_METRICS_BIND=127.0.0.1:9093
