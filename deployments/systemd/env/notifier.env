# The notifier. Read by systemd as root, so keep this file 0600. Channel
# secrets live in files named by notifier.json, never here.
WETECHINETMON_NOTIFY_CONFIG=/etc/wetechinetmon/notifier.json
WETECHINETMON_NOTIFY_DATABASE_URL="host=127.0.0.1 user=wetechinetmon password=CHANGE_ME dbname=wetechinetmon"
# WETECHINETMON_NOTIFY_DATABASE_CA_FILE=/etc/wetechinetmon/tls/ca.pem
WETECHINETMON_NOTIFY_METRICS_BIND=127.0.0.1:9093
