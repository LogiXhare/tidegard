# The incident manager. It applies the database migrations at start.
# Read by systemd as root, so keep this file 0600.
TIDEGARD_INCIDENT_DATABASE_URL="host=127.0.0.1 user=tidegard password=CHANGE_ME dbname=tidegard"
# TIDEGARD_INCIDENT_DATABASE_CA_FILE=/etc/tidegard/tls/ca.pem
TIDEGARD_INCIDENT_METRICS_BIND=127.0.0.1:9091
