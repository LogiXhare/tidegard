# The incident manager. It applies the database migrations at start.
# Read by systemd as root, so keep this file 0600.
WETECHINETMON_INCIDENT_DATABASE_URL="host=127.0.0.1 user=wetechinetmon password=CHANGE_ME dbname=wetechinetmon"
# WETECHINETMON_INCIDENT_DATABASE_CA_FILE=/etc/wetechinetmon/tls/ca.pem
WETECHINETMON_INCIDENT_METRICS_BIND=127.0.0.1:9091
