# The API and the NOC UI. Read by systemd as root, so keep this file 0600.
WETECHINETMON_API_BIND=127.0.0.1:8080
WETECHINETMON_API_DATABASE_URL="host=127.0.0.1 user=wetechinetmon password=CHANGE_ME dbname=wetechinetmon"
# WETECHINETMON_API_DATABASE_CA_FILE=/etc/wetechinetmon/tls/ca.pem
WETECHINETMON_API_WEB_ROOT=/opt/wetechinetmon/share/web
WETECHINETMON_API_MITIGATION_GUARD_FILE=/etc/wetechinetmon/guard.json
# Serve HTTPS directly, or put a TLS proxy in front:
# WETECHINETMON_API_TLS_CERT_FILE=/etc/wetechinetmon/tls/api.pem
# WETECHINETMON_API_TLS_KEY_FILE=/etc/wetechinetmon/tls/api-key.pem
