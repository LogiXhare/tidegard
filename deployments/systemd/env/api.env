# The API and the NOC UI. Read by systemd as root, so keep this file 0600.
TIDEGARD_API_BIND=127.0.0.1:8080
TIDEGARD_API_DATABASE_URL="host=127.0.0.1 user=tidegard password=CHANGE_ME dbname=tidegard"
# TIDEGARD_API_DATABASE_CA_FILE=/etc/tidegard/tls/ca.pem
TIDEGARD_API_WEB_ROOT=/opt/tidegard/share/web
TIDEGARD_API_MITIGATION_GUARD_FILE=/etc/tidegard/guard.json
# Serve HTTPS directly, or put a TLS proxy in front:
# TIDEGARD_API_TLS_CERT_FILE=/etc/tidegard/tls/api.pem
# TIDEGARD_API_TLS_KEY_FILE=/etc/tidegard/tls/api-key.pem
