# The BGP mitigator. Read by systemd as root, so keep this file 0600.
# guard.json ships dry-run with BGP off: see docs/installation/mitigation.md
# before changing it.
TIDEGARD_MITIGATOR_CONFIG=/etc/tidegard/mitigator.json
TIDEGARD_MITIGATOR_DATABASE_URL="host=127.0.0.1 user=tidegard password=CHANGE_ME dbname=tidegard"
# TIDEGARD_MITIGATOR_DATABASE_CA_FILE=/etc/tidegard/tls/ca.pem
TIDEGARD_MITIGATOR_METRICS_BIND=127.0.0.1:9094
