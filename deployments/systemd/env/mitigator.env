# The BGP mitigator. Read by systemd as root, so keep this file 0600.
# guard.json ships dry-run with BGP off: see docs/installation/mitigation.md
# before changing it.
WETECHINETMON_MITIGATOR_CONFIG=/etc/wetechinetmon/mitigator.json
WETECHINETMON_MITIGATOR_DATABASE_URL="host=127.0.0.1 user=wetechinetmon password=CHANGE_ME dbname=wetechinetmon"
# WETECHINETMON_MITIGATOR_DATABASE_CA_FILE=/etc/wetechinetmon/tls/ca.pem
WETECHINETMON_MITIGATOR_METRICS_BIND=127.0.0.1:9094
