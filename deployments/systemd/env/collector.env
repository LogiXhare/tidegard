# The flow collector and detector. Read by systemd as root, so keep this
# file 0600. Reference: docs/configuration/.
WETECHINETMON_COLLECTOR_BIND=0.0.0.0:2055
WETECHINETMON_COLLECTOR_METRICS_BIND=127.0.0.1:9090
# network/length[@tenant[@hostgroup]], comma-separated: your own prefixes.
WETECHINETMON_COLLECTOR_LOCAL_PREFIXES=192.0.2.0/24@default
WETECHINETMON_COLLECTOR_DETECTION_POLICY_FILE=/etc/wetechinetmon/detection-policy.json
# WETECHINETMON_COLLECTOR_CLICKHOUSE_URL=http://127.0.0.1:8123
# Plaintext is allowed only to this host. Elsewhere, set the CA file too.
WETECHINETMON_COLLECTOR_INCIDENT_DATABASE_URL="host=127.0.0.1 user=wetechinetmon password=CHANGE_ME dbname=wetechinetmon"
# WETECHINETMON_COLLECTOR_INCIDENT_DATABASE_CA_FILE=/etc/wetechinetmon/tls/ca.pem
