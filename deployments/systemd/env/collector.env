# The flow collector and detector. Read by systemd as root, so keep this
# file 0600. Reference: docs/configuration/.
TIDEGARD_COLLECTOR_BIND=0.0.0.0:2055
# Your routers' addresses or networks, comma-separated: flows from
# anywhere else are dropped unread. Unset accepts any source.
TIDEGARD_COLLECTOR_ALLOWED_EXPORTERS=192.0.2.0/24
TIDEGARD_COLLECTOR_METRICS_BIND=127.0.0.1:9090
# network/length[@tenant[@hostgroup]], comma-separated: your own prefixes.
TIDEGARD_COLLECTOR_LOCAL_PREFIXES=192.0.2.0/24@default
TIDEGARD_COLLECTOR_DETECTION_POLICY_FILE=/etc/tidegard/detection-policy.json
# Must equal every policy's "window"; a policy with another is never evaluated.
TIDEGARD_COLLECTOR_DETECTION_WINDOW_SECS=5
# ClickHouse: plain http:// to this host only; elsewhere https:// and a CA.
# TIDEGARD_COLLECTOR_CLICKHOUSE_URL=http://127.0.0.1:8123
# TIDEGARD_COLLECTOR_CLICKHOUSE_CA_FILE=/etc/tidegard/tls/ca.pem
# TIDEGARD_COLLECTOR_CLICKHOUSE_USER=tidegard_collector
# TIDEGARD_COLLECTOR_CLICKHOUSE_PASSWORD_FILE=/etc/tidegard/clickhouse-password
# Plaintext is allowed only to this host. Elsewhere, set the CA file too.
TIDEGARD_COLLECTOR_INCIDENT_DATABASE_URL="host=127.0.0.1 user=tidegard password=CHANGE_ME dbname=tidegard"
# TIDEGARD_COLLECTOR_INCIDENT_DATABASE_CA_FILE=/etc/tidegard/tls/ca.pem
