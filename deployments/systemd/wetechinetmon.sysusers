# System users for WetechiNetMon (ADR 0052): one per service, so no
# service can read another's secrets. The API and the mitigator share the
# guard file through the wetechinetmon-guard group.
g wetechinetmon-guard -
u wetechinetmon-collector - "WetechiNetMon collector" / /usr/sbin/nologin
u wetechinetmon-incident-manager - "WetechiNetMon incident manager" / /usr/sbin/nologin
u wetechinetmon-api - "WetechiNetMon API" / /usr/sbin/nologin
u wetechinetmon-notifier - "WetechiNetMon notifier" / /usr/sbin/nologin
u wetechinetmon-mitigator - "WetechiNetMon mitigator" / /usr/sbin/nologin
m wetechinetmon-api wetechinetmon-guard
m wetechinetmon-mitigator wetechinetmon-guard
