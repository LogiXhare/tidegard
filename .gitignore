# Node (docs/validation tooling, and later apps/web)
node_modules/
package-lock.json
# The NOC UI's lockfile is the supply-chain record and must be
# committed (ADR 0044).
!apps/web/package-lock.json
npm-debug.log*

# MkDocs build output
site/

# Python (mkdocs-material virtualenvs, if used locally)
.venv/
__pycache__/
*.pyc

# Rust (from Phase 2 onward)
target/
# Cargo.lock is committed (not ignored): this workspace ships binaries
# (collector, flow-replay), and per docs/security-principles.md
# ("reproducible builds where possible") binary crates should pin their
# exact dependency graph. Library-only crates conventionally ignore it,
# but this workspace is mixed and binaries dominate.

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment / secrets — never commit these
.env
.env.*
*.pem
*.key
!**/deployments/**/*.key.example

# Local override configs
*.local.yml
*.local.yaml
