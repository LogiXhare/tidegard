    {
      "id": 5,
      "type": "timeseries",
      "title": "Datagrams and records",
      "description": "Datagrams received and Data Records decoded per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(rate(tidegard_collector_flow_datagrams_received_total[$__rate_interval]))",
          "legendFormat": "datagrams",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(rate(tidegard_collector_parsed_flow_records_total[$__rate_interval]))",
          "legendFormat": "records",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(rate(tidegard_collector_normalized_flows_total[$__rate_interval]))",
          "legendFormat": "normalized",
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 6,
      "type": "timeseries",
