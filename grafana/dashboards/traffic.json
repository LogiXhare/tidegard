          "rawSql": "SELECT address AS host, sum(bytes) AS bytes, sum(packets) AS packets, sum(flows) AS flows\nFROM wetechinetmon_host_traffic\nWHERE $__timeFilter(timestamp)\nGROUP BY host\nORDER BY bytes DESC\nLIMIT 20"
