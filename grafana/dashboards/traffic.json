{
  "id": null,
  "uid": "wnm-traffic",
  "title": "WetechiNetMon — Traffic",
  "description": "Traffic seen by the collector, from the ClickHouse analytics tables. Deployment-wide: the traffic tables carry no tenant until Phase 8.",
  "tags": [
    "wetechinetmon"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "wetechinetmon"
      ],
      "asDropdown": true,
      "title": "WetechiNetMon",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds_clickhouse",
        "label": "ClickHouse",
        "query": "grafana-clickhouse-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic by family",
      "description": "Bits per second of all traffic the collector saw, IPv4 and IPv6.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT time, family, sum(v) AS bps FROM (\n  SELECT $__timeInterval(timestamp) AS time, 'IPv4' AS family, sum(bytes) * 8 / $__interval_s AS v\n  FROM wetechinetmon_total_ipv4_traffic WHERE $__timeFilter(timestamp) GROUP BY time\n  UNION ALL\n  SELECT $__timeInterval(timestamp) AS time, 'IPv6' AS family, sum(bytes) * 8 / $__interval_s AS v\n  FROM wetechinetmon_total_ipv6_traffic WHERE $__timeFilter(timestamp) GROUP BY time\n) GROUP BY time, family ORDER BY time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Packets by family",
      "description": "Packets per second of all traffic the collector saw.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT time, family, sum(v) AS pps FROM (\n  SELECT $__timeInterval(timestamp) AS time, 'IPv4' AS family, sum(packets) * 1 / $__interval_s AS v\n  FROM wetechinetmon_total_ipv4_traffic WHERE $__timeFilter(timestamp) GROUP BY time\n  UNION ALL\n  SELECT $__timeInterval(timestamp) AS time, 'IPv6' AS family, sum(packets) * 1 / $__interval_s AS v\n  FROM wetechinetmon_total_ipv6_traffic WHERE $__timeFilter(timestamp) GROUP BY time\n) GROUP BY time, family ORDER BY time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Protocol mix",
      "description": "Bits per second by IP protocol, IPv4.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time,\n  sum(tcp_bytes) * 8 / $__interval_s AS tcp,\n  sum(udp_bytes) * 8 / $__interval_s AS udp,\n  sum(icmp_bytes) * 8 / $__interval_s AS icmp,\n  (sum(bytes) - sum(tcp_bytes) - sum(udp_bytes) - sum(icmp_bytes)) * 8 / $__interval_s AS other\nFROM wetechinetmon_total_ipv4_traffic\nWHERE $__timeFilter(timestamp)\nGROUP BY time ORDER BY time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Attack indicators",
      "description": "TCP SYN, fragmented and dropped packets per second, IPv4. A rising line is worth a look even when total traffic is flat.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${ds_clickhouse}"
      },
      "interval": "15s",
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
