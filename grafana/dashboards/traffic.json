          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${ds_clickhouse}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(timestamp) AS time,\n  sum(tcp_syn_packets) / $__interval_s AS tcp_syn,\n  sum(fragmented_packets) / $__interval_s AS fragmented,\n  sum(dropped_packets) / $__interval_s AS dropped\nFROM wetechinetmon_total_ipv4_traffic\nWHERE $__timeFilter(timestamp)\nGROUP BY time ORDER BY time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
