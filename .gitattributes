# Shell scripts must keep LF line endings regardless of core.autocrlf.
# A CRLF shebang makes the file unrunnable on Linux and in WSL
# ("bad interpreter: /bin/sh^M"), and the Git hooks below are executed
# on whatever platform a contributor clones to.
*.sh text eol=lf
.githooks/** text eol=lf

# What the release tarball installs on Linux (ADR 0052).
deployments/systemd/** text eol=lf
deployments/config/** text eol=lf
deployments/docker/** text eol=lf
deployments/docker-compose/** text eol=lf
